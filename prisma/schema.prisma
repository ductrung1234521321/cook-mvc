generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- ENUMS ---
enum Role {
  USER
  ADMIN
}

enum Platform {
  ANDROID
  IOS
  WEB
}

enum MediaType {
  IMAGE
  VIDEO
  FILE
}

// (Mới) Enum cho loại thông báo
enum NotificationType {
  LIKE_RECIPE     // Ai đó like bài viết
  COMMENT_RECIPE  // Ai đó bình luận bài viết
  REPLY_COMMENT   // Ai đó trả lời bình luận
  FOLLOW          // Ai đó theo dõi bạn
  MENTION         // Ai đó nhắc đến bạn (@)
  SYSTEM          // Thông báo hệ thống
}

// --- MODELS ---

model User {
  id        String    @id @default(uuid()) @db.Uuid
  email     String    @unique
  password  String
  fullName  String?   @map("full_name")
  nickName  String?   @map("nick_name")
  dob       DateTime?
  address   String?
  phone     String?
  role      Role      @default(USER)
  isLocked  Boolean   @default(false) @map("is_locked")
  avatarId  String?   @unique @map("avatar_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")

  // Relations
  avatar        MediaAssets?   @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]
  devices       Device[]
  mediaAssets   MediaAssets[]
  recipes       Recipe[]

  // Social Interactions
  bookmarks     Bookmark[]
  collections   Collection[]

  // (Mới) Follow System
  followedBy    UserFollow[] @relation("UserFollowedBy") // Những người follow mình (Followers)
  following     UserFollow[] @relation("UserFollowing")  // Những người mình follow (Following)

  // (Mới) Notification System
  notificationsReceived Notification[] @relation("NotiReceiver") // Thông báo mình nhận được
  notificationsSent     Notification[] @relation("NotiActor")    // Hành động mình gây ra tạo thông báo cho người khác
  
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Device {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  fcmToken      String?   @map("fcm_token") @db.VarChar(255)
  platform      Platform?
  lastSeenAt    DateTime? @map("last_seen_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([fcmToken])
  @@unique([userId, fcmToken])
  @@map("devices")
}

model MediaAssets {
  id       String    @id @default(uuid()) @db.Uuid
  ownerId  String    @map("owner_id") @db.Uuid
  type     MediaType
  publicId String    @map("public_id")
  url      String    @map("url")

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  avatarOf       User?    @relation("UserAvatar")
  coverOfRecipes Recipe[]
  primaryOfSteps RecipeStep[]
  stepMedias     StepMedia[]

  @@map("media_assets")
}

model Recipe {
  id           String  @id @default(uuid()) @db.Uuid
  authorId     String  @map("author_id") @db.Uuid
  title        String
  titleNorm    String  @map("title_norm")
  description  String?
  coverMediaId String? @map("cover_media_id") @db.Uuid

  commentsCount Int      @default(0) @map("comments_count")
  likesCount    Int      @default(0) @map("likes_count")

  author     User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  coverMedia MediaAssets? @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)

  ingredients RecipeIngredient[]
  steps       RecipeStep[]

  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @default(now()) @map("updated_at")

  // Social Interactions
  bookmarks     Bookmark[]
  tags          RecipeTag[]
  inCollections CollectionRecipe[]
  
  // (Mới) Liên kết với Notification (Để biết thông báo thuộc bài viết nào)
  notifications Notification[]

  @@map("recipes")
}

model Ingredient {
  id       Int    @id @default(autoincrement())
  name     String @unique
  nameNorm String @unique @map("name_norm")

  recipes RecipeIngredient[]

  @@map("ingredients")
}

model RecipeIngredient {
  recipeId     String @map("recipe_id") @db.Uuid
  ingredientId Int    @map("ingredient_id")

  qtyNum  Float?  @map("qty_num")
  qtyText String? @map("qty_text")
  unit    String?

  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

model RecipeStep {
  id             String  @id @default(uuid()) @db.Uuid
  recipeId       String  @map("recipe_id") @db.Uuid
  stepNo         Int     @map("step_no")
  title          String?
  body           String  @map("description")
  durationSec    Int?    @map("duration_sec")
  primaryMediaId String? @map("primary_media_id") @db.Uuid

  recipe       Recipe       @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  primaryMedia MediaAssets? @relation(fields: [primaryMediaId], references: [id], onDelete: SetNull)

  stepMedias StepMedia[]

  @@map("recipe_steps")
}

model StepMedia {
  stepId    String @map("step_id") @db.Uuid
  mediaId   String @map("media_id") @db.Uuid
  sortOrder Int    @default(0) @map("sort_order")

  step  RecipeStep  @relation(fields: [stepId], references: [id], onDelete: Cascade)
  media MediaAssets @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([stepId, mediaId])
  @@map("step_media")
}

model Bookmark {
  userId    String   @map("user_id") @db.Uuid
  recipeId  String   @map("recipe_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([userId, recipeId])
  @@map("bookmarks")
}

model Tag {
  id       Int    @id @default(autoincrement())
  name     String @unique @map("name")
  nameNorm String @unique @map("name_norm")

  recipes RecipeTag[]

  @@map("tags")
}

model RecipeTag {
  recipeId String @map("recipe_id") @db.Uuid
  tagId    Int    @map("tag_id")

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
  @@map("recipe_tags")
}

model Collection {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  title     String
  isPublic  Boolean  @default(false) @map("is_public")
  createdAt DateTime @default(now()) @map("created_at")

  owner   User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  recipes CollectionRecipe[]

  @@map("collections")
}

model CollectionRecipe {
  collectionId String @map("collection_id") @db.Uuid
  recipeId     String @map("recipe_id") @db.Uuid
  sortOrder    Int    @default(0) @map("sort_order")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  recipe     Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([collectionId, recipeId])
  @@map("collection_recipes")
}

// --- CÁC MODEL MỚI BỔ SUNG (NOTIFICATION & FOLLOW) ---

// 1. Bảng theo dõi người dùng
model UserFollow {
  followerId  String   @map("follower_id") @db.Uuid // Người đi theo dõi
  followingId String   @map("following_id") @db.Uuid // Người được theo dõi
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("UserFollowedBy", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@map("user_follows")
}

// 2. Bảng thông báo
model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid // Người NHẬN thông báo
  actorId   String           @map("actor_id") @db.Uuid // Người TẠO RA thông báo (người like, comment...)
  type      NotificationType
  isRead    Boolean          @default(false) @map("is_read")
  
  // Dữ liệu liên quan (Tùy loại thông báo mà field nào sẽ có giá trị)
  recipeId  String?          @map("recipe_id") @db.Uuid
  
  // Payload dùng để lưu thêm thông tin phụ (VD: snippet comment, tiêu đề recipe tại thời điểm đó)
  // Prisma hỗ trợ JSONB trên Postgres
  payload   Json?            @map("payload") 

  createdAt DateTime         @default(now()) @map("created_at")

  // Relations
  user      User     @relation("NotiReceiver", fields: [userId], references: [id], onDelete: Cascade)
  actor     User     @relation("NotiActor", fields: [actorId], references: [id], onDelete: Cascade)
  recipe    Recipe?  @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([userId]) // Index để query list notification của user cho nhanh
  @@map("notifications")
}
